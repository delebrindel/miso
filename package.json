{
  "name": "@delebrindel/miso",
  "version": "0.1.0-beta.0",
  "description": "Miso: a small, accessible React component library documented in Storybook.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "react",
    "components",
    "accessible",
    "tailwind",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delebrindel/miso.git"
  },
  "homepage": "https://github.com/delebrindel/miso#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/theme.css",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
